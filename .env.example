# Cloud is the default. Missing configuration blocks entry, never falls back to local.
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
# Public publishable (sb_publishable_...) or legacy anon key ONLY.
# Never enter service_role, sb_secret_..., database password, or access token here.
VITE_SUPABASE_PUBLISHABLE_KEY=
# Explicit local prototype, for existing regression tests only. Never production.
VITE_BOPLI_MODE=cloud
