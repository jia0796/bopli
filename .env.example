# Cloud is the default. Missing configuration blocks entry, never falls back to local.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_FUNCTIONS_REGION=asia-east1
# Only for local emulator testing (use a demo-* project ID).
VITE_FIREBASE_EMULATORS=false
# Explicit local prototype, for existing regression tests only. Never production.
VITE_BOPLI_MODE=cloud
