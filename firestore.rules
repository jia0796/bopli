// groups: existing metadata + epoch:int and readerAuthUids:list (server-only).
// identities/{authUid}: immutable internal id + authUid binding and display profile.
// groups/{id}/{members,activities,expenses,repayments,settlementSnapshots}: domain rows.
// invites/{sha256}: groupId, createdBy, expiresAt; only callable functions access.
// All writes pass server validators + transactions. Admin SDK bypasses rules.
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function groupReader(groupId) {
      return signedIn() && exists(/databases/$(database)/documents/groups/$(groupId)) &&
        request.auth.uid in get(/databases/$(database)/documents/groups/$(groupId)).data.readerAuthUids;
    }
    match /identities/{authUid} {
      allow get: if signedIn() && request.auth.uid == authUid;
      allow list, create, update, delete: if false;
    }
    match /groups/{groupId} {
      allow read: if signedIn() && request.auth.uid in resource.data.readerAuthUids;
      allow create, update, delete: if false;
      match /{collectionName}/{id} {
        allow read: if collectionName in ['members','activities','expenses','repayments','settlementSnapshots'] && groupReader(groupId);
        allow create, update, delete: if false;
      }
    }
    match /{document=**} { allow read, write: if false; }
  }
}
